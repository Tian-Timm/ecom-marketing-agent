{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "CHA CUP Marketing Image Template", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "template_id", "name", "version", "status", "supported_ratios", "background", "layers"],
  "properties": {
    "schema_version": {"const": "1.0"}, "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 80}, "version": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "PUBLISHED"]},
    "supported_ratios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["1:1", "3:4"]}},
    "background": {"type": "object", "additionalProperties": false, "required": ["asset"], "properties": {"asset": {"type": "string", "minLength": 1}, "badge_text": {"type": "string", "maxLength": 40}}},
    "layers": {"type": "array", "minItems": 3, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type", "field", "rect", "fit"], "properties": {"type": {"const": "product_image"}, "field": {"const": "product_image_path"}, "rect": {"$ref": "#/$defs/rect"}, "fit": {"enum": ["contain", "cover"]}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "field", "rect", "fit"], "properties": {"type": {"const": "logo"}, "field": {"const": "logo_image_path"}, "rect": {"$ref": "#/$defs/rect"}, "fit": {"enum": ["contain", "cover"]}}},
      {"$ref": "#/$defs/main_text_layer"}, {"$ref": "#/$defs/promo_price_layer"}
    ]}}
  },
  "$defs": {
    "rect": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}},
    "text_layer": {"type": "object", "additionalProperties": false, "required": ["type", "field", "rect", "max_font_size", "min_font_size", "max_lines", "color", "align"], "properties": {"type": {"enum": ["main_text", "promo_price"]}, "field": {"enum": ["main_text", "promo_price"]}, "rect": {"$ref": "#/$defs/rect"}, "max_font_size": {"type": "integer", "minimum": 8, "maximum": 160}, "min_font_size": {"type": "integer", "minimum": 8, "maximum": 160}, "max_lines": {"type": "integer", "minimum": 1, "maximum": 6}, "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "align": {"enum": ["left", "center", "right"]}}},
    "main_text_layer": {"allOf": [{"$ref": "#/$defs/text_layer"}, {"properties": {"type": {"const": "main_text"}, "field": {"const": "main_text"}}}]},
    "promo_price_layer": {"allOf": [{"$ref": "#/$defs/text_layer"}, {"properties": {"type": {"const": "promo_price"}, "field": {"const": "promo_price"}}}]}
  }
}
